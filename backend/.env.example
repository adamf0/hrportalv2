# HRPortal Go Backend Environment Example
PORT=3000
ALLOW_CORS=1
ALLOWED_ORIGINS=https://hrportal.unpak.ac.id,http://localhost:3000,http://localhost:5173
ALLOW_DOMAINS=hrportal.unpak.ac.id,localhost
API_KEY_CO_ID=your_api_key_here
WHOAMI_URL=http://localhost:4000/api/v2/account/whoami

# Databases
DB_HRPORTAL=hrportal:password@tcp(172.16.20.121:3306)/unpak_hrportal?charset=utf8mb4&parseTime=True&loc=Local
DB_SIMAK=host2:password@tcp(172.16.21.3:30130)/unpak_simak?charset=utf8mb4&parseTime=True&loc=Local
DB_SIMPEG=simpegunpak:password@tcp(172.16.20.121:3306)/unpak_simpeg?charset=utf8mb4&parseTime=True&loc=Local
DB_SIMPEG_NEW=newsimpeg:password@tcp(172.16.20.121:3306)/unpak_newsimpeg?charset=utf8mb4&parseTime=True&loc=Local

# S3 Object Storage
STORAGE_CONNECTOR=storageSvcS3
S3_ENDPOINT=s3.fra.databucket.eu
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=fra
S3_USE_SSL=true

# Active Directory / LDAP
AD_SERVER=ldaps://ldap.unpak.ac.id:636
AD_DOMAIN=unpak.ac.id
AD_USER=svc_adpanel@unpak.ac.id
AD_PASS=your_ldap_password
LDAP_DN=DC=unpak,DC=ac,DC=id
